[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '+09:00'
skip-name-resolve

# 저사양 서버 기준값. 운영 서버 메모리가 정해지면 다시 맞춘다.
innodb_buffer_pool_size        = 256M
innodb_log_buffer_size         = 16M
innodb_flush_log_at_trx_commit = 2      # 게임 데이터: 1초 이내 유실 감수하고 쓰기 성능 우선
max_connections                = 50
performance_schema             = OFF    # 메모리 약 200MB+ 절약
table_open_cache               = 400
tmp_table_size                 = 32M
max_heap_table_size            = 32M
